# Copy this file to tools/.secrets/.env and fill in your values.
# tools/.secrets/ is gitignored — nothing here goes to GitHub.

# ──────────────────────────────────────────────────────────────────────────
# AUTH — choose ONE of the two paths below.
# ──────────────────────────────────────────────────────────────────────────

# Path A: Service-account key (works locally AND in CI). Recommended if you
# can create a JSON key. Set this to either an absolute path to the key file
# OR the raw JSON contents.
#
# GOOGLE_SA_JSON=/Users/nnaugle/Code/called_to_serve/tools/.secrets/sa-key.json

# Path B: Application Default Credentials (no key file). Works LOCALLY only.
# Leave GOOGLE_SA_JSON unset, then once on your machine run:
#
#   gcloud auth application-default login
#
# Sync will authenticate as your Google account. The sheets/Drive folder
# must already be shared with you (they are — you own them).

# ──────────────────────────────────────────────────────────────────────────
# SHEET IDS — required for live mode. Grab from the sheet URL between
# "/d/" and "/edit". Setting both flips sync.mjs from sample → live.
# ──────────────────────────────────────────────────────────────────────────

SUBMISSIONS_SHEET_ID=1zRulLylIJxaCL7jpH6DDzwsPyWoBdXwH8jaqQ3d8PWE
ROSTER_SHEET_ID=1prR5rGLlYJjdLl2YwSlI7oIBSojUTeqyirE4CTNpHf4
