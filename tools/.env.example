# Copy this file to tools/.secrets/.env and fill in your values.
# tools/.secrets/ is gitignored — nothing here goes to GitHub.
#
# Steps (after you've set up the service account in Google Cloud):
#   1. Save your downloaded service-account JSON key as tools/.secrets/sa-key.json
#   2. Copy this file to tools/.secrets/.env and edit the four values below
#   3. From the project root:  node tools/sync.mjs
#      → writes web/public/missionaries.json with live data + photos

# Path to the service-account key JSON file you downloaded from Google Cloud.
# The sheets.mjs / photos.mjs modules accept either an absolute path here
# OR the raw JSON contents. The path form is simpler locally.
GOOGLE_SA_JSON=/Users/nnaugle/Code/called_to_serve/tools/.secrets/sa-key.json

# Spreadsheet IDs. Grab from the sheet URL between "/d/" and "/edit".
# Photo submissions sheet (columns B/C/D/E = name, photo URL, Yes/No, bio):
SUBMISSIONS_SHEET_ID=1zRulLylIJxaCL7jpH6DDzwsPyWoBdXwH8jaqQ3d8PWE

# Master roster sheet (the one whose "Missionaries" tab has the column A list):
ROSTER_SHEET_ID=1prR5rGLlYJjdLl2YwSlI7oIBSojUTeqyirE4CTNpHf4
